{
  "manifest_version": 3,
  "name": "Font Finder",
  "version": "1.0.0",
  "description": "Inspect fonts and typography on any webpage.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Font Finder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-font-finder": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Toggle Font Finder"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
